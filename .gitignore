# --- Python ---
__pycache__/
*.py[cod]
backend/.venv/

# SQLite db + uploaded images (runtime state)
# NOTE: keep comments on their OWN line — git does not treat a mid-line "#"
# as a comment, so a trailing note silently breaks the pattern.
backend/data/

# --- Node / Next.js ---
node_modules/
frontend/.next/
frontend/out/
frontend/.turbo/
frontend/tsconfig.tsbuildinfo

# --- Secrets & env ---
.env
*.local

# --- OS / editor ---
.DS_Store
.idea/
.vscode/

# --- Personal reference docs (kept local, not part of the deliverable) ---
# Root-level markdown only, so postman/README.md and any future nested docs stay tracked.
/*.md
!/README.md
