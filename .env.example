# Copy to .env at the repo root, then fill in the key.
# docker compose reads this file for the backend service.

# --- AI (required for the three Gemini checks) ---
# Without it, typo/roster, matchup and design/theme honestly report `failed`;
# sponsor-audit and safe-zone still run.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Auth ---
JWT_SECRET=change-me-to-any-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- CORS (only needed if you serve the frontend from another origin) ---
# CORS_ORIGINS=["http://localhost:3000"]
